# techshort does not require an API key. The Codex provider uses existing CLI authentication.
TECHSHORT_PROJECTS_ROOT=projects
TECHSHORT_REVIEWER_ID=local-reviewer
# Local synthesis uses enabled Windows System.Speech voices; no TTS key is read.
# Organic publishing and metrics are manual-only; do not add platform tokens or cookies here.
# Optional local-only transcription. The model must already exist; techshort never downloads one.
TECHSHORT_WHISPER_CLI=
TECHSHORT_WHISPER_MODEL=
