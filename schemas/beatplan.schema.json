{
  "$defs": {
    "Beat": {
      "additionalProperties": false,
      "properties": {
        "animation_beats": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Animation Beats",
          "type": "array"
        },
        "approximate_duration": {
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Approximate Duration",
          "type": "number"
        },
        "beat_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Beat Id",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Claim Ids",
          "type": "array"
        },
        "evidence_span_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Evidence Span Ids",
          "type": "array"
        },
        "layout_family": {
          "enum": [
            "hero",
            "full-diagram",
            "split-comparison",
            "evidence-receipt",
            "numeric-result",
            "limitation"
          ],
          "title": "Layout Family",
          "type": "string"
        },
        "narration_guidance": {
          "maxLength": 800,
          "minLength": 8,
          "title": "Narration Guidance",
          "type": "string"
        },
        "on_screen_text": {
          "maxLength": 100,
          "minLength": 1,
          "title": "On Screen Text",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "primitive_hint": {
          "enum": [
            "KineticText",
            "SourceReceipt",
            "MechanismDiagram",
            "ChartReveal",
            "ParameterSimulation",
            "Comparison",
            "LimitationCard",
            "RasterScan",
            "GridWarp",
            "BeforeAfterOverlay",
            "EvidenceHighlight",
            "Timeline"
          ],
          "title": "Primitive Hint",
          "type": "string"
        },
        "purpose": {
          "maxLength": 500,
          "minLength": 8,
          "title": "Purpose",
          "type": "string"
        },
        "role": {
          "enum": [
            "hook",
            "re-hook",
            "setup",
            "mechanism",
            "evidence",
            "consequence",
            "tradeoff",
            "limitation",
            "resolution"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "visual_guidance": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Visual Guidance",
          "type": "string"
        }
      },
      "required": [
        "beat_id",
        "order",
        "role",
        "purpose",
        "narration_guidance",
        "on_screen_text",
        "visual_guidance",
        "primitive_hint",
        "layout_family",
        "animation_beats",
        "claim_ids",
        "approximate_duration"
      ],
      "title": "Beat",
      "type": "object"
    },
    "FactualLock": {
      "additionalProperties": false,
      "description": "Exact claim-content snapshot that creative artifacts may not expand.",
      "properties": {
        "approval_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Hash"
        },
        "assertion": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Assertion",
          "type": "string"
        },
        "claim_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "claim_state_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Claim State Hash",
          "type": "string"
        },
        "evidence_span_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Evidence Span Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "claim_state_hash",
        "assertion",
        "evidence_span_ids"
      ],
      "title": "FactualLock",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "angle": {
      "enum": [
        "surprising-result",
        "everyday-mechanism",
        "engineering-tradeoff"
      ],
      "title": "Angle",
      "type": "string"
    },
    "beats": {
      "items": {
        "$ref": "#/$defs/Beat"
      },
      "maxItems": 12,
      "minItems": 5,
      "title": "Beats",
      "type": "array"
    },
    "claims_version_id": {
      "title": "Claims Version Id",
      "type": "string"
    },
    "factual_locks": {
      "items": {
        "$ref": "#/$defs/FactualLock"
      },
      "minItems": 1,
      "title": "Factual Locks",
      "type": "array"
    },
    "narrative_brief_version_id": {
      "title": "Narrative Brief Version Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "version_id": {
      "pattern": "^beats-[0-9a-f]{16}$",
      "title": "Version Id",
      "type": "string"
    }
  },
  "required": [
    "version_id",
    "narrative_brief_version_id",
    "claims_version_id",
    "angle",
    "factual_locks",
    "beats"
  ],
  "title": "BeatPlan",
  "type": "object"
}
