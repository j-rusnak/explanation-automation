{
  "$defs": {
    "RetentionFinding": {
      "additionalProperties": false,
      "properties": {
        "beat_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Beat Id"
        },
        "category": {
          "enum": [
            "dishonest-cold-open",
            "deceptive-withholding",
            "clickbait-language",
            "unsupported-engagement-claim",
            "missing-payoff",
            "attention-gap",
            "cadence",
            "word-count",
            "missing-limitation",
            "missing-evidence",
            "hook-drift",
            "payoff-drift"
          ],
          "title": "Category",
          "type": "string"
        },
        "event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "message": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "segment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segment Id"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "category",
        "severity",
        "message"
      ],
      "title": "RetentionFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "beat_plan_version_id": {
      "title": "Beat Plan Version Id",
      "type": "string"
    },
    "blocking": {
      "title": "Blocking",
      "type": "boolean"
    },
    "critique_id": {
      "pattern": "^retention-critique-[0-9a-f]{16}$",
      "title": "Critique Id",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/RetentionFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "narrative_brief_version_id": {
      "title": "Narrative Brief Version Id",
      "type": "string"
    },
    "retention_plan_version_id": {
      "title": "Retention Plan Version Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "script_version_id": {
      "title": "Script Version Id",
      "type": "string"
    },
    "spoken_word_count": {
      "minimum": 0,
      "title": "Spoken Word Count",
      "type": "integer"
    },
    "spoken_words_per_minute": {
      "minimum": 0,
      "title": "Spoken Words Per Minute",
      "type": "number"
    }
  },
  "required": [
    "critique_id",
    "retention_plan_version_id",
    "narrative_brief_version_id",
    "beat_plan_version_id",
    "script_version_id",
    "input_hash",
    "spoken_word_count",
    "spoken_words_per_minute",
    "blocking"
  ],
  "title": "RetentionCritique",
  "type": "object"
}
