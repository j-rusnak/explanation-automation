{
  "$defs": {
    "ReviewStatus": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "stale"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "ScriptSegment": {
      "additionalProperties": false,
      "properties": {
        "approval_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Hash"
        },
        "approximate_duration": {
          "exclusiveMinimum": 0,
          "title": "Approximate Duration",
          "type": "number"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "pronunciation_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pronunciation Notes"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "pending"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "segment_type": {
          "enum": [
            "factual",
            "hook",
            "transition",
            "analogy",
            "caveat",
            "limitation",
            "cta"
          ],
          "title": "Segment Type",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "text",
        "segment_type",
        "approximate_duration"
      ],
      "title": "ScriptSegment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "angle": {
      "enum": [
        "surprising-result",
        "everyday-mechanism",
        "engineering-tradeoff"
      ],
      "title": "Angle",
      "type": "string"
    },
    "claims_version_id": {
      "title": "Claims Version Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/ScriptSegment"
      },
      "title": "Segments",
      "type": "array"
    },
    "version_id": {
      "title": "Version Id",
      "type": "string"
    }
  },
  "required": [
    "version_id",
    "claims_version_id",
    "angle",
    "segments"
  ],
  "title": "ScriptManifest",
  "type": "object"
}
