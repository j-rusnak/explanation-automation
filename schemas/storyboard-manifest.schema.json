          "type": "string"
        },
        "kind": {
          "const": "annotated-chart",
          "title": "Kind",
          "type": "string"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/ChartSeries"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Series",
          "type": "array"
        },
        "x_axis": {
          "$ref": "#/$defs/ChartAxis"
        },
        "y_axis": {
          "$ref": "#/$defs/ChartAxis"
        }
      },
      "required": [
        "kind",
        "chart_type",
        "x_axis",
        "y_axis",
        "series"
