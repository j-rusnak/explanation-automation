      "required": [
        "kind",
        "source_title",
        "excerpt",
        "locator",
        "evidence_id",
        "highlights"
      ],
      "title": "EvidenceHighlightVisual",
      "type": "object"
    },
    "GridWarpVisual": {
      "additionalProperties": false,
      "properties": {
        "after_label": {
          "title": "After Label",
          "type": "string"
        },
        "before_label": {
          "title": "Before Label",
          "type": "string"
        },
        "columns": {
          "maximum": 20,
          "minimum": 3,
          "title": "Columns",
          "type": "integer"
        },
        "curvature": {
          "maximum": 1,
          "minimum": -1,
          "title": "Curvature",
          "type": "number"
        },
        "kind": {
          "const": "grid-warp",
          "title": "Kind",
          "type": "string"
        },
        "rows": {
          "maximum": 20,
          "minimum": 3,
          "title": "Rows",
          "type": "integer"
        },
        "skew": {
          "maximum": 1,
          "minimum": -1,
          "title": "Skew",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "rows",
        "columns",
        "skew",
        "curvature",
        "before_label",
        "after_label"
