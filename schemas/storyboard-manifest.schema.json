{
  "$defs": {
    "EdgeSpec": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "EdgeSpec",
      "type": "object"
    },
    "NodeSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "state": {
          "default": "normal",
          "enum": [
            "normal",
            "active",
            "muted"
          ],
          "title": "State",
          "type": "string"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "id",
        "label",
        "x",
        "y"
      ],
      "title": "NodeSpec",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "stale"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "accessibility_description": {
          "title": "Accessibility Description",
          "type": "string"
        },
        "asset_ids": {
          "items": {
            "type": "string"
          },
          "title": "Asset Ids",
          "type": "array"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "dependency_hash": {
          "title": "Dependency Hash",
          "type": "string"
        },
        "duration": {
          "exclusiveMinimum": 0,
          "title": "Duration",
          "type": "number"
        },
        "evidence_label": {
          "anyOf": [
            {
              "enum": [
                "DOCUMENTED",
                "MEASURED",
                "SIMULATED",
                "INFERRED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Label"
        },
        "on_screen_text": {
          "title": "On Screen Text",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "primitive": {
          "enum": [
            "KineticText",
            "SourceReceipt",
            "MechanismDiagram",
            "ChartReveal",
            "ParameterSimulation",
            "Comparison",
            "LimitationCard"
          ],
          "title": "Primitive",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "pending"
        },
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "script_segment_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Script Segment Ids",
          "type": "array"
        },
        "start_time": {
          "minimum": 0,
          "title": "Start Time",
          "type": "number"
        },
        "theme_overrides": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Theme Overrides",
          "type": "object"
        },
        "transition": {
          "default": "fade",
          "enum": [
            "cut",
            "fade",
            "slide"
          ],
          "title": "Transition",
          "type": "string"
        },
        "visual": {
          "$ref": "#/$defs/VisualSpec"
        }
      },
      "required": [
        "scene_id",
        "order",
        "start_time",
        "duration",
        "primitive",
        "script_segment_ids",
        "on_screen_text",
        "visual",
        "accessibility_description",
        "dependency_hash"
      ],
      "title": "Scene",
      "type": "object"
    },
    "VisualSpec": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "citation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/EdgeSpec"
          },
          "title": "Edges",
          "type": "array"
        },
        "evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Labels",
          "type": "array"
        },
        "left": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Left"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/NodeSpec"
          },
          "title": "Nodes",
          "type": "array"
        },
        "parameter": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameter"
        },
        "right": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Right"
        },
        "series": {
          "items": {
            "type": "number"
          },
          "maxItems": 30,
          "title": "Series",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "VisualSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "scenes": {
      "items": {
        "$ref": "#/$defs/Scene"
      },
      "title": "Scenes",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "script_version_id": {
      "title": "Script Version Id",
      "type": "string"
    },
    "version_id": {
      "title": "Version Id",
      "type": "string"
    }
  },
  "required": [
    "version_id",
    "script_version_id",
    "scenes"
  ],
  "title": "StoryboardManifest",
  "type": "object"
}
