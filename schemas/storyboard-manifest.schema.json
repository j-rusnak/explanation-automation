        "distortion": {
          "maximum": 1,
          "minimum": -1,
          "title": "Distortion",
          "type": "number"
        },
        "kind": {
          "const": "raster-scan",
          "title": "Kind",
          "type": "string"
        },
        "rows": {
          "maximum": 32,
          "minimum": 6,
          "title": "Rows",
          "type": "integer"
        },
        "scan_label": {
          "title": "Scan Label",
          "type": "string"
        },
        "subject": {
          "enum": [
            "blade",
            "pole",
            "grid",
            "rotor"
          ],
          "title": "Subject",
          "type": "string"
