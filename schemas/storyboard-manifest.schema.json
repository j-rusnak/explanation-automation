    "Scene": {
      "additionalProperties": false,
      "properties": {
        "accessibility_description": {
          "title": "Accessibility Description",
          "type": "string"
        },
        "asset_ids": {
          "items": {
            "type": "string"
          },
          "title": "Asset Ids",
          "type": "array"
        },
        "citation_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation Label"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "dependency_hash": {
          "title": "Dependency Hash",
          "type": "string"
        },
        "duration": {
          "exclusiveMinimum": 0,
          "title": "Duration",
          "type": "number"
        },
        "evidence_label": {
          "anyOf": [
            {
              "enum": [
                "DOCUMENTED",
                "MEASURED",
                "SIMULATED",
                "INFERRED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Label"
        },
        "layout": {
          "default": "hero",
          "enum": [
            "hero",
            "full-diagram",
            "split",
            "evidence",
            "numeric",
            "limitation"
          ],
          "title": "Layout",
          "type": "string"
        },
        "motion": {
          "default": "precise",
          "enum": [
            "calm",
            "precise",
            "energetic"
          ],
          "title": "Motion",
          "type": "string"
        },
        "on_screen_text": {
          "title": "On Screen Text",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "primitive": {
          "enum": [
            "KineticText",
            "SourceReceipt",
            "MechanismDiagram",
            "ChartReveal",
            "ParameterSimulation",
            "Comparison",
            "LimitationCard",
            "RasterScan",
            "TimeSlice",
            "GridWarp",
            "BeforeAfterOverlay",
            "AnnotatedChart",
            "EvidenceHighlight",
            "ProcessFlow",
            "Timeline"
          ],
          "title": "Primitive",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "pending"
        },
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "script_segment_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Script Segment Ids",
          "type": "array"
        },
        "start_time": {
          "minimum": 0,
          "title": "Start Time",
          "type": "number"
        },
        "theme_overrides": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Theme Overrides",
          "type": "object"
        },
        "transition": {
          "default": "fade",
          "enum": [
            "cut",
            "fade",
            "slide"
          ],
          "title": "Transition",
          "type": "string"
        },
        "visual": {
          "anyOf": [
            {
              "$ref": "#/$defs/VisualSpec"
            },
            {
              "discriminator": {
                "mapping": {
                  "annotated-chart": "#/$defs/AnnotatedChartVisual",
                  "before-after-overlay": "#/$defs/BeforeAfterOverlayVisual",
                  "comparison": "#/$defs/ComparisonVisual",
                  "evidence-highlight": "#/$defs/EvidenceHighlightVisual",
                  "grid-warp": "#/$defs/GridWarpVisual",
                  "kinetic-text": "#/$defs/KineticTextVisual",
                  "limitation": "#/$defs/LimitationVisual",
                  "mechanism-diagram": "#/$defs/MechanismDiagramVisual",
                  "parameter-simulation": "#/$defs/ParameterSimulationVisual",
                  "process-flow": "#/$defs/ProcessFlowVisual",
                  "raster-scan": "#/$defs/RasterScanVisual",
                  "source-receipt": "#/$defs/SourceReceiptVisual",
                  "time-slice": "#/$defs/TimeSliceVisual",
                  "timeline": "#/$defs/TimelineVisual"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/KineticTextVisual"
                },
                {
                  "$ref": "#/$defs/SourceReceiptVisual"
                },
                {
                  "$ref": "#/$defs/MechanismDiagramVisual"
                },
                {
                  "$ref": "#/$defs/AnnotatedChartVisual"
                },
                {
                  "$ref": "#/$defs/ParameterSimulationVisual"
                },
                {
                  "$ref": "#/$defs/ComparisonVisual"
                },
                {
                  "$ref": "#/$defs/LimitationVisual"
                },
                {
                  "$ref": "#/$defs/RasterScanVisual"
                },
                {
                  "$ref": "#/$defs/TimeSliceVisual"
                },
                {
                  "$ref": "#/$defs/GridWarpVisual"
                },
                {
                  "$ref": "#/$defs/BeforeAfterOverlayVisual"
                },
                {
                  "$ref": "#/$defs/EvidenceHighlightVisual"
                },
                {
                  "$ref": "#/$defs/ProcessFlowVisual"
                },
                {
                  "$ref": "#/$defs/TimelineVisual"
                }
              ]
            }
          ],
          "title": "Visual"
        }
      },
      "required": [
        "scene_id",
        "order",
        "start_time",
        "duration",
        "primitive",
        "script_segment_ids",
        "on_screen_text",
        "visual",
        "accessibility_description",
        "dependency_hash"
      ],
      "title": "Scene",
      "type": "object"
    },
