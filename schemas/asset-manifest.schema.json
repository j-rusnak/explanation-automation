{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "asset_type": {
          "title": "Asset Type",
          "type": "string"
        },
        "creator": {
          "title": "Creator",
          "type": "string"
        },
        "embedding_allowed": {
          "title": "Embedding Allowed",
          "type": "boolean"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "local_path": {
          "title": "Local Path",
          "type": "string"
        },
        "origin": {
          "title": "Origin",
          "type": "string"
        },
        "required_attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Attribution"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "pending"
        },
        "rights_status": {
          "enum": [
            "original",
            "user-owned",
            "permissively-licensed",
            "citation-only",
            "unknown",
            "restricted"
          ],
          "title": "Rights Status",
          "type": "string"
        },
        "scene_usage": {
          "items": {
            "type": "string"
          },
          "title": "Scene Usage",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        }
      },
      "required": [
        "asset_id",
        "asset_type",
        "local_path",
        "sha256",
        "origin",
        "creator",
        "license",
        "rights_status",
        "embedding_allowed"
      ],
      "title": "Asset",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "stale"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Assets",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "version_id": {
      "title": "Version Id",
      "type": "string"
    }
  },
  "required": [
    "version_id"
  ],
  "title": "AssetManifest",
  "type": "object"
}
