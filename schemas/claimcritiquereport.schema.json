{
  "$defs": {
    "ClaimCritiqueIssue": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "unsupported",
            "partial-support",
            "missing-scope",
            "causal-wording",
            "uncertainty",
            "number-or-unit",
            "conflicting-evidence"
          ],
          "title": "Category",
          "type": "string"
        },
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "message": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "category",
        "severity",
        "message"
      ],
      "title": "ClaimCritiqueIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claims_version_id": {
      "title": "Claims Version Id",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ClaimCritiqueIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "provider": {
      "enum": [
        "fixture",
        "manual",
        "codex"
      ],
      "title": "Provider",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "version_id": {
      "title": "Version Id",
      "type": "string"
    }
  },
  "required": [
    "version_id",
    "claims_version_id",
    "provider",
    "summary"
  ],
  "title": "ClaimCritiqueReport",
  "type": "object"
}
