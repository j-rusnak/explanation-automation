{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "evidence_span_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Span Ids",
          "type": "array"
        },
        "relationship": {
          "enum": [
            "direct",
            "inferred",
            "synthesis"
          ],
          "title": "Relationship",
          "type": "string"
        },
        "evidence_label": {
          "enum": [
            "documented",
            "measured",
            "simulated",
            "inferred"
          ],
          "title": "Evidence Label",
          "type": "string"
        },
        "reasoning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "limitation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limitation"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "risk": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "pending"
        },
        "reviewer_edits": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Edits"
        },
        "approval_timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Timestamp"
        },
        "approval_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Hash"
        }
      },
      "required": [
        "claim_id",
        "text",
        "evidence_span_ids",
        "relationship",
        "evidence_label",
        "confidence"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "stale"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "version_id": {
      "title": "Version Id",
      "type": "string"
    },
    "evidence_version_id": {
      "title": "Evidence Version Id",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    }
  },
  "required": [
    "version_id",
    "evidence_version_id",
    "claims"
  ],
  "title": "ClaimsManifest",
  "type": "object"
}
