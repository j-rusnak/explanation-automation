{
  "$defs": {
    "VisualFinding": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "unsupported-visual-assertion",
            "missing-evidence-receipt",
            "missing-limitation-card",
            "repeated-primitive",
            "repeated-layout",
            "duplicated-narration",
            "overlong-on-screen-text",
            "missing-units",
            "weak-visual-metaphor",
            "static-sequence"
          ],
          "title": "Category",
          "type": "string"
        },
        "message": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "scene_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Key"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "category",
        "severity",
        "message"
      ],
      "title": "VisualFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "beat_plan_version_id": {
      "title": "Beat Plan Version Id",
      "type": "string"
    },
    "blocking": {
      "title": "Blocking",
      "type": "boolean"
    },
    "critique_id": {
      "pattern": "^visual-critique-[0-9a-f]{16}$",
      "title": "Critique Id",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/VisualFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "narrative_brief_version_id": {
      "title": "Narrative Brief Version Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "storyboard_guidance_version_id": {
      "title": "Storyboard Guidance Version Id",
      "type": "string"
    }
  },
  "required": [
    "critique_id",
    "narrative_brief_version_id",
    "beat_plan_version_id",
    "storyboard_guidance_version_id",
    "input_hash",
    "blocking"
  ],
  "title": "VisualCritique",
  "type": "object"
}
