{
  "$defs": {
    "ObservationSnapshot": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "comment_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment Count"
        },
        "completed_view_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed View Count"
        },
        "experiment_id": {
          "title": "Experiment Id",
          "type": "string"
        },
        "follow_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Follow Count"
        },
        "like_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Like Count"
        },
        "platform": {
          "$ref": "#/$defs/OrganicPlatform"
        },
        "publication_reference": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Publication Reference",
          "type": "string"
        },
        "save_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Save Count"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "share_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Share Count"
        },
        "skipped_view_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skipped View Count"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "source": {
          "const": "manual-organic",
          "default": "manual-organic",
          "title": "Source",
          "type": "string"
        },
        "total_watch_time_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Watch Time Seconds"
        },
        "variant_id": {
          "title": "Variant Id",
          "type": "string"
        },
        "view_count": {
          "minimum": 0,
          "title": "View Count",
          "type": "integer"
        },
        "window_ended_at": {
          "format": "date-time",
          "title": "Window Ended At",
          "type": "string"
        },
        "window_started_at": {
          "format": "date-time",
          "title": "Window Started At",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "experiment_id",
        "variant_id",
        "platform",
        "publication_reference",
        "window_started_at",
        "window_ended_at",
        "captured_at",
        "view_count"
      ],
      "title": "ObservationSnapshot",
      "type": "object"
    },
    "OrganicPlatform": {
      "enum": [
        "tiktok",
        "instagram-reels"
      ],
      "title": "OrganicPlatform",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshots": {
      "items": {
        "$ref": "#/$defs/ObservationSnapshot"
      },
      "maxItems": 1000,
      "title": "Snapshots",
      "type": "array"
    }
  },
  "required": [
    "experiment_id"
  ],
  "title": "ObservationLog",
  "type": "object"
}
