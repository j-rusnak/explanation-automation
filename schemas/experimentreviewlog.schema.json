{
  "$defs": {
    "ExperimentReviewDecision": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "approve",
            "reject"
          ],
          "title": "Decision",
          "type": "string"
        },
        "experiment_id": {
          "title": "Experiment Id",
          "type": "string"
        },
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        },
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "object_type": {
          "enum": [
            "experiment",
            "variant"
          ],
          "title": "Object Type",
          "type": "string"
        },
        "review_id": {
          "title": "Review Id",
          "type": "string"
        },
        "reviewer_identifier": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Reviewer Identifier",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "review_id",
        "experiment_id",
        "object_type",
        "object_id",
        "object_hash",
        "decision",
        "reviewer_identifier"
      ],
      "title": "ExperimentReviewDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decisions": {
      "items": {
        "$ref": "#/$defs/ExperimentReviewDecision"
      },
      "maxItems": 1000,
      "title": "Decisions",
      "type": "array"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "experiment_id"
  ],
  "title": "ExperimentReviewLog",
  "type": "object"
}
